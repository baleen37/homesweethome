# 크롤러 사이트 설정 (naver 또는 hogangnono)
CRAWLER_SITE=naver

# 기본 크롤러 설정
CRAWLER_TIMEOUT=30
CRAWLER_HEADLESS=true
CRAWLER_OUTPUT_FILE=
CRAWLER_OUTPUT_DIR=output
CRAWLER_REGION_CODE=
CRAWLER_START_DATE=
CRAWLER_END_DATE=
CRAWLER_PAGE_SIZE=20
CRAWLER_RETRY_ATTEMPTS=3
CRAWLER_RETRY_DELAY=1.0
CRAWLER_DELAY_SECONDS=2.0
CRAWLER_USE_THREADING=false
CRAWLER_MAX_WORKERS=4
CRAWLER_API_KEY=

# 네이버 부동산 설정
NAVER_TIMEOUT=30
NAVER_RATE_LIMIT=2.0
NAVER_RATE_LIMIT_MIN=0.1
NAVER_RATE_LIMIT_MAX=10.0
NAVER_RATE_LIMIT_INCREMENT=0.5
NAVER_RATE_LIMIT_DECREMENT_AFTER=10
NAVER_API_COMPLEX_LIST=/cluster/ajax/complexList
NAVER_API_COMPLEX_DETAIL=/cluster/ajax/complexDetail
NAVER_API_ARTICLE_LIST=/cluster/ajax/articleList
NAVER_PAGE_SIZE=20
NAVER_MAX_PAGE=100
NAVER_DEFAULT_TRADE_TYPE=A1
NAVER_DEFAULT_REALTY_TYPE=APT

# 호갱노노 API 설정
# 호갱노노(https://hogangnono.com)에서 API 키를 발급받을 수 있습니다.
HOGANGNONO_API_KEY=your_hogangnono_api_key_here
HOGANGNONO_TIMEOUT=30
HOGANGNONO_RATE_LIMIT=1.0
HOGANGNONO_RATE_LIMIT_MIN=0.1
HOGANGNONO_RATE_LIMIT_MAX=10.0
HOGANGNONO_RATE_LIMIT_INCREMENT=0.5
HOGANGNONO_RATE_LIMIT_DECREMENT_AFTER=10
HOGANGNONO_API_VERSION=v1
HOGANGNONO_BASE_URL=https://api.hogangnono.com
HOGANGNONO_ENDPOINT_COMPLEXES=/complexes
HOGANGNONO_ENDPOINT_LISTINGS=/listings
HOGANGNONO_ENDPOINT_PRICES=/prices
HOGANGNONO_PAGE_SIZE=50
HOGANGNONO_MAX_PAGE=200
HOGANGNONO_DEFAULT_PROPERTY_TYPE=apartment
HOGANGNONO_DEFAULT_TRANSACTION_TYPE=sale
HOGANGNONO_DAILY_REQUEST_LIMIT=10000
