# Nix-direnv configuration
use flake

# Additional environment variables
export PYTHONPATH="${PWD}/src:$PYTHONPATH"
export CRAWLER_OUTPUT_DIR="${PWD}/output"

# Create output directory if it doesn't exist
mkdir -p "$CRAWLER_OUTPUT_DIR"

# Set Playwright browsers path to external installation
# Nix-provided browsers are outdated (version 1181 vs required 1194)
export PLAYWRIGHT_BROWSERS_PATH="/Users/jito.hello/.playwright"

# Export environment variables from .env if it exists
if [ -f ".env" ]; then
  set -a
  source .env
  set +a
fi